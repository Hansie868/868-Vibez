{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MediaSuite .868 Library Bundle",
  "type": "object",
  "required": ["schema", "schemaVersion", "app", "exportedAt", "data"],
  "properties": {
    "schema": { "const": "868.mediasuite.library" },
    "schemaVersion": { "type": "integer" },
    "app": { "const": "MediaSuite" },
    "phase": { "type": "string" },
    "exportedAt": { "type": "string" },
    "localOnly": { "type": "boolean" },
    "compatibility": { "type": "object" },
    "data": {
      "type": "object",
      "properties": {
        "tracks": { "type": "array" },
        "metadata": { "type": "array" },
        "playlists": { "type": "array" },
        "crates": { "type": "array" },
        "smartCrateRules": { "type": "array" },
        "hotCues": { "type": "array" },
        "beatGrids": { "type": "array" },
        "midiMappings": { "type": "array" },
        "settings": { "type": "array" },
        "diagnostics": { "type": "object" }
      }
    }
  }
}
